# MyAI Avatar Studio — environment template
# Copy to .env and adjust as needed. Never commit real secrets.

APP_NAME=MyAI Avatar Studio
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=127.0.0.1
PORT=8000

# Storage (optional overrides; defaults resolve under the project root)
# PROJECT_ROOT=C:\path\to\my-ai-avatar-studio
# DATA_DIR=C:\path\to\my-ai-avatar-studio\data
# RAW_MEDIA_DIR=C:\path\to\my-ai-avatar-studio\data\raw
# AVATARS_DIR=C:\path\to\my-ai-avatar-studio\data\avatars
# PROCESSED_DIR=C:\path\to\my-ai-avatar-studio\data\processed

# Upload limits (bytes)
MAX_VIDEO_UPLOAD_BYTES=524288000
MAX_AUDIO_UPLOAD_BYTES=104857600
